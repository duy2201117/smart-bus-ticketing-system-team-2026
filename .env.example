PORT=3001
DEMO_MODE=true
# Development mặc định dùng database RAM để tránh lỗi PGlite native/WASM trên Windows.
# Bỏ comment dòng dưới nếu muốn lưu DB PGlite persistent; nếu mở lỗi trong demo, server tự fallback sang RAM.
# DATA_DIR=data/pg
# Set DATABASE_URL to use PostgreSQL instead of local PGlite.
# DATABASE_URL=postgresql://user:password@localhost:5432/smartbus
# Comma-separated production origins, for example https://smartbus.example.com
# SMARTBUS_ORIGIN=https://smartbus.example.com
TRUST_PROXY=false
NODE_ENV=development

# HMAC secret for signed sandbox/payment callbacks. CHANGE THIS outside local demo.
PAYMENT_WEBHOOK_SECRET=change-this-smartbus-webhook-secret
# Private evidence files (student/pupil/senior discount profiles). Keep outside public/.
PRIVATE_STORAGE_DIR=data/private
